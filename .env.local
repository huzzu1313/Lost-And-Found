# MongoDB Connection (local installation)
MONGO_URL=mongodb://localhost:27017/lostandfound

# Database name
DB_NAME=lostandfound

# NextAuth Configuration
NEXTAUTH_SECRET=your_super_secret_key_change_this_in_production
NEXTAUTH_URL=http://localhost:3000

# Admin Email (gets admin role automatically)
ADMIN_EMAIL=admin@lostandfound.com

# CORS Settings
CORS_ORIGINS=http://localhost:3000
